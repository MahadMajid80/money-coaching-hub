# ── Required on the live server ───────────────────────────────────────────
# The public address of the site (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://moneycoachinghub.com
# A long random string that signs dashboard logins. Generate one with:
#   openssl rand -hex 32
PAYLOAD_SECRET=
# Where the content database lives. Keep it OUTSIDE the deploy folder so redeploys never wipe it.
DATABASE_URI=file:/home/USER/mch-data/payload.db
# Where uploaded photos are stored. Same rule: outside the deploy folder.
MEDIA_DIR=/home/USER/mch-data/media

# ── On Vercel (instead of DATABASE_URI / MEDIA_DIR, because Vercel's disk is read-only) ──
# Hosted database from turso.tech (or Vercel → Storage → Turso, which fills these in for you)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Photo storage: Vercel → Storage → Blob (connecting it fills this in for you)
BLOB_READ_WRITE_TOKEN=
# Lets Vercel Cron run scheduled publishing (any long random string)
CRON_SECRET=

# ── Email copies of enquiries (optional: enquiries are always saved in the dashboard) ──
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Defaults to the email in Site settings
CONTACT_TO=
CONTACT_FROM=

# ── MailerLite (optional: sign-ups are always saved in the dashboard) ──
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
MAILERLITE_GROUP_SIDE_HUSTLE=
